# ── Worker ─────────────────────────────────────────────
# Which worker to start: evolution | smc_evolution | orb_evolution |
# session_range_evolution | mr_evolution | orb2r_evolution | signal
LAB_WORKER=evolution
LAB_MODE=paper
LAB_STATE=/app/state
LAB_DATA_SOURCE=dukascopy
# LAB_DATA_CACHE=/app/artifacts/cache/m1
# LAB_STRATEGY_PATH=/app/state/strategy.yaml
# Fresh volume seeding: a state template copied into an empty /app/state
# LAB_STATE_TEMPLATE=state-template

# ── Telegram (signal worker) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional data API keys (leave blank for free public data) ──
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
GLASSNODE_API_KEY=
NEWS_API_KEY=

# Note: the historical HERMES_* variable names are still accepted as a
# fallback (see trading_lab/env.py), so existing deployments keep working.
